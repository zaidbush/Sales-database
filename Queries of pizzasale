select * from pizzahut.pizzas;
USE pizzahut;

-- Retrieve the total number of order placed

select count(order_id) from pizzahut.orders;

-- Calculate the total revenue generated from pizza sale

DROP DATABASE sales;

select 
sum(orders_details.quantity * pizzas.price) as total_sales
from orders_details join pizzas
on pizzas.pizza_id = order_details.pizza_id;


SELECT 
    SUM(orders_details.quantity * CAST(pizzas.price AS DECIMAL(10,2))) AS total_sales
FROM orders_details
JOIN pizzas
    ON pizzas.pizza_id = orders_details.pizza_id;
   
   
    
DESCRIBE pizzas;    

-- List the top 5 most ordered pizza type along with them 

SELECT 
    pizza_types.name, SUM(orders_details.quantity) AS quantity
FROM
    pizza_types
        JOIN
    pizzas ON pizza_types.pizza_type_id = pizzas.pizza_type_id
        JOIN
    orders_details ON orders_details.pizza_id = pizzas.pizza_id
GROUP BY pizza_types.name
ORDER BY quantity DESC
LIMIT 5; 

SELECT SUM(sales) AS total_sales
FROM orders;

SELECT *
FROM pizzas
WHERE total_sales > 1000;

SELECT 
    pizzas.pizza_id,
    SUM(orders_details.quantity * CAST(pizzas.price AS DECIMAL(10,2))) AS total_sales
FROM orders_details
JOIN pizzas
    ON pizzas.pizza_id = orders_details.pizza_id
GROUP BY pizzas.pizza_id
ORDER BY total_sales DESC;

SELECT 
    MAX(sales) AS highest_sale,
    MIN(sales) AS lowest_sale
FROM orders;

